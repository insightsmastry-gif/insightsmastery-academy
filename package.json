{
  "name": "insightsmastery-academy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Static learning site for the InsightsMastery Power BI, DAX, Power Query and SQL Server handbooks.",
  "homepage": "https://insightsmastry-gif.github.io/insightsmastery-academy/",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "verify": "node scripts/build.mjs && node scripts/check-site.mjs",
    "start": "node scripts/build.mjs && node scripts/dev-server.mjs --watch",
    "dev": "npm run start",
    "serve": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
